{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "certicon-quiz",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "certicon-quiz-leads",
      "database_id": "3ab53a8c-8d33-4e37-a5fc-2ac24b0ec877",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "META_PIXEL_ID": "2095584267906662",
    "CRM_WEBHOOK_URL": "https://app.convexcrm.com.br/api/webhooks/integrations/13f5b44cfe0e450fbf7d12f9a83a28a3"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
